# ── InsForge (backend) ────────────────────────────────────────────────
# La API key es de acceso total: solo servidor, nunca NEXT_PUBLIC_.
# Si da 401, regenerarla y volver a linkear: npx @insforge/cli link
INSFORGE_API_BASE_URL=https://tu-proyecto.region.insforge.app
INSFORGE_API_KEY=
# Emails habilitados para entrar al panel, separados por coma.
INSFORGE_ADMIN_EMAILS=

# ── Mercado Pago (Checkout API vía Orders) ────────────────────────────
# Access token de la aplicación. Server-only.
MERCADOPAGO_AUTH_HEADER=
# Public key: se compila dentro del bundle, por eso lleva NEXT_PUBLIC_.
# Cambiarla exige reconstruir el sitio, no alcanza con guardarla.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Secreto de firma del webhook, del panel de MP en la sección Webhooks.
# Sin esto el webhook rechaza todas las notificaciones (falla cerrado).
MERCADOPAGO_WEBHOOK_SECRET=

# ── Avisos por email ──────────────────────────────────────────────────
# Vacío desactiva el envío sin romper pedidos: quedan registrados en la
# tabla `notificaciones` con estado `omitido`.
# Valores posibles: resend | insforge  (insforge requiere plan pago)
EMAIL_PROVIDER=
RESEND_API_KEY=
# Remitente verificado, ej: Impasto <pedidos@impastoiguazu.com.ar>
EMAIL_FROM

# Aviso al local cuando entra un pedido. Sin esto no se avisa a nadie, pero
# tampoco se rompe el pedido: queda como "omitido" en la tabla notificaciones.
# El token sale de @BotFather. Los chat ids van separados por coma.
TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_IDS=

# ── SEO ───────────────────────────────────────────────────────────────
# URL canónica del sitio, sin barra final. Es lo que se publica en el
# canonical, el sitemap, robots.txt y los datos estructurados.
# Si queda vacía, Netlify inyecta `URL` sola en el build; el fallback final
# es el subdominio actual de Netlify. Se lee en build: cambiarla exige
# reconstruir, no alcanza con guardarla en el panel de Netlify.
NEXT_PUBLIC_SITE_URL=

# ── Chatbot vendedor (DeepSeek) ───────────────────────────────────────
# Sin la key el chat queda desactivado y el widget muestra WhatsApp: no se
# rompe nada. La key es server-only, NUNCA NEXT_PUBLIC_.
# Se saca de https://platform.deepseek.com y necesita saldo cargado.
DEEPSEEK_API_KEY=
# Opcional. Por defecto deepseek-v4-flash, que es el barato.
DEEPSEEK_MODEL=
# Opcional. Por defecto https://api.deepseek.com
DEEPSEEK_BASE_URL=
